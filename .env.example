# ---- LLM (Section 3 / D11 / D17). Both free tiers. Gemini is primary, Groq is fallback.
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash-lite       # 15 RPM free (measured 2026-09-11); gemini-3.6-flash is 20 requests/DAY, unusable
GEMINI_FALLBACK_MODEL=gemma-4-26b-a4b-it # ~30 RPM free; same key
GEMINI_RPM=15
GEMINI_TPM=250000
GEMINI_FALLBACK_RPM=30
GEMINI_FALLBACK_TPM=15000
GROQ_API_KEY=              # https://console.groq.com/keys
GROQ_MODEL=openai/gpt-oss-120b           # llama-3.3-70b-versatile was retired; free tier 30 RPM but 8k tokens/min
GROQ_RPM=30
GROQ_TPM=8000

# ---- Retrieval (Section 2 / 11)
ALLOW_PRIVATE_URLS=false   # set true ONLY for local batch runs against localhost fixture sites
FETCH_TIMEOUT_MS=10000
CRAWL_MAX_PAGES=12
FETCH_MAX_BYTES=1500000

# ---- API (apps/api)
PORT=4000
MONGODB_URI=               # MongoDB Atlas connection string
SESSION_SECRET=            # long random string for signing session cookies
WEB_ORIGIN=http://localhost:3000

# ---- Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
