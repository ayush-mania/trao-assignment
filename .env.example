# ---- LLM (Section 3 / D11 / D17). Both free tiers. Gemini is primary, Groq is fallback.
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=              # https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
LLM_RPM=8                  # requests/minute budget the limiter enforces (set from your dashboard)
LLM_TPM=200000             # tokens/minute budget

# ---- Retrieval (Section 2 / 11)
ALLOW_PRIVATE_URLS=false   # set true ONLY for local batch runs against localhost fixture sites
FETCH_TIMEOUT_MS=10000
CRAWL_MAX_PAGES=12
FETCH_MAX_BYTES=1500000

# ---- API (apps/api)
PORT=4000
MONGODB_URI=               # MongoDB Atlas connection string
SESSION_SECRET=            # long random string for signing session cookies
WEB_ORIGIN=http://localhost:3000

# ---- Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
